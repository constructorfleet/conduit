# Copy to .env. Compose reads it automatically.

# --- Conduit -----------------------------------------------------------------

# Pick exactly one. There is no open default: a server with neither refuses to
# start, which is the intended behaviour rather than a papercut.
#
# A token file goes in ./secrets, which is mounted read-only at /run/secrets and
# is git-ignored. Generate a token with `openssl rand -hex 32`; the file must
# not be group- or world-readable. See docs/configuration.md for its shape.
#CONDUIT_TOKENS=/run/secrets/tokens.json
#
# Or serve the API with no authentication at all. Reasonable on a laptop,
# never on a network you share.
#CONDUIT_ALLOW_ANONYMOUS=1

# Host port for the service API.
#CONDUIT_PORT=8080

# `tracing_subscriber` filter.
#CONDUIT_LOG=info

# --- Wake word servers (docker compose --profile openwakeword up) ------------

# Only needed for detection you do not run in Conduit itself. openWakeWord
# models can be scored in process: put them in the `wake-models` volume and
# give the provider definition a `local` runtime, with no service at all.
#
# One variable per engine, because which one you run decides which phrases you
# can ask for. Each image must speak the Wyoming detect/detection protocol on
# port 10400.
#CONDUIT_OPENWAKEWORD_IMAGE=
#CONDUIT_MICROWAKEWORD_IMAGE=
#CONDUIT_NANOWAKEWORD_IMAGE=

# --- Speaker identification (docker compose --profile speaker-id up) ---------

# A published tag to run instead of building from ./services/speaker-id.
# The GPU tag needs a runtime with GPU access; see services/speaker-id/README.md.
#CONDUIT_SPEAKER_ID_IMAGE=conduit-speaker-id:speechbrain

# Optional bearer token for the identification service. Set the same value as
# the api_key on the provider definition.
#SPEAKER_ID_API_KEY=

# --- Local speech recognition (docker compose --profile wyoming-asr up) -------

# A published tag to run instead of building from ./services/wyoming-asr.
#CONDUIT_WYOMING_ASR_IMAGE=conduit-wyoming-asr:canary

# Which weights to serve. The model licence is yours to honour: the default,
# NVIDIA Canary, is CC-BY-4.0 and attribution is required. See
# services/wyoming-asr/README.md.
#ASR_ENGINE=canary
#ASR_MODEL=nvidia/canary-1b-v2

# `cuda` needs the GPU image tag and a runtime with GPU access. The process
# refuses to start rather than run far slower in silence.
#ASR_DEVICE=cpu

# Longest utterance accepted, in seconds. Samples are held in memory until the
# audio stops, so this is the bound on what one connection can allocate.
#ASR_MAX_SECONDS=120
