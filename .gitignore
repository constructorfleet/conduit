/target
**/*.rs.bk
# Coverage report, written to the repo root by the `coverage` CI job.
/cobertura.xml
.DS_Store
.env
__pycache__/
.venv
/.cargo/registry
.playwright-cli/
output/playwright/
output/

# openWakeWord models, fetched by scripts/fetch-wake-models.sh. Upstream
# release artifacts rather than ours, so they are downloaded and not carried.
/crates/conduit-wake/tests/models/

# The Silero VAD model, fetched by scripts/fetch-vad-model.sh, on the same
# terms: an upstream artifact, downloaded rather than carried.
/crates/conduit-vad/tests/models/

# ESPHome build output and credentials (Wi-Fi password, API encryption key).
.esphome/
secrets.yaml
.opencode/

# Agent worktrees, created under the repo by the coding agent harness.
.claude/
